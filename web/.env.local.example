# Copy to .env.local for local dev (gitignored). In production set these in Vercel.

GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-flash-latest

# The tunnel URL in front of the local ERPNext proxy (e.g. cloudflared quick tunnel)
ERPNEXT_PROXY_URL=https://xxxx.trycloudflare.com
# Must match proxy/.env ERPNEXT_PROXY_TOKEN
ERPNEXT_PROXY_TOKEN=your-proxy-token

ACCESS_PASSCODE=set-a-passcode
